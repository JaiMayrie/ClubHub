# Environment Configuration
NODE_ENV=development
PORT=5000
JWT_SECRET=your_jwt_secret # (in bash you can do `openssl rand -base64 32` to generate a secure random string)
FRONTEND_URL=http://localhost:3000

# Database Configuration
# DB_HOST=localhost # Use 'localhost' for local development
DB_HOST=db # Use 'db' as the hostname for the PostgreSQL service in Docker
DB_PORT=5432
DB_NAME=clubhub
DB_USER=postgres
DB_PASSWORD=postgres
